{
  "name": "Signal Drift (Godot 4)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ],
      "settings": {
        "files.associations": {
          "*.gd": "gdscript",
          "*.tscn": "ini"
        }
      }
    }
  },

  "remoteUser": "vscode"
}
