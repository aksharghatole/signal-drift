; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Signal Drift"
config/description="A radio-tuning puzzle game."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/show_image=false

[autoload]

Signals="*res://scripts/autoload/Signals.gd"
SceneRouter="*res://scripts/autoload/SceneRouter.gd"
MessageDB="*res://scripts/autoload/MessageDB.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/radio_theme.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.035, 0.065, 0.08, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
